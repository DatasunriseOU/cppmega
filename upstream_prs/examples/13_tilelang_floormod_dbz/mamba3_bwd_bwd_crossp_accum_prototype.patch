--- a/mamba_ssm/ops/tilelang/mamba3/mamba3_mimo_bwd.py
+++ b/mamba_ssm/ops/tilelang/mamba3/mamba3_mimo_bwd.py
@@ -1342,3 +1342,542 @@
             ddA, ddt, dtrap, dq_bias_tilelang, dk_bias_tilelang,
             dmimo_v, dmimo_z, dmimo_o, dangles, 
             dD, dz_tilelang)
+
+
+
+@tilelang.jit(
+    out_idx=[],
+    pass_configs={
+        tilelang.PassConfigKey.TL_DISABLE_TMA_LOWER: True,
+        tilelang.PassConfigKey.TL_DISABLE_WARP_SPECIALIZED: True,
+        tilelang.PassConfigKey.TL_ENABLE_FAST_MATH: True,
+    })
+def mamba_mimo_bwd_bwd_ptile_crossp_accum(
+    B,
+    S,
+    H,
+    G,
+    N,
+    P,
+    R,
+    hasZ,
+    hasD,
+    reduceO,
+    chunk_size: int = 16,
+    rotary_dim_divisor: int = 4,
+    dtype: str = 'float16',
+    threads: int = 256,
+    num_stages: int = 0,
+    p_tile: int = 64,
+) -> torch.Tensor:
+    """P_TILE bwd_bwd prototype with explicit cross-P accumulators.
+
+    The loop-carried dstates are stored in a caller-provided scratch tensor,
+    one [N, P_TILE] tile at a time. Per-chunk cross-P products are accumulated
+    into full [fused,fused] / [fused,N] fragments before any DK/DQ/DDA* writes.
+    """
+
+    accum_dtype = 'float32'
+    nchunks = tilelang.cdiv(S, chunk_size)
+    tail_len = S % chunk_size
+    fused_chunk_size = chunk_size * R
+    P_TILE = p_tile
+    n_p_tiles = P // P_TILE
+
+    if P % P_TILE != 0:
+        raise ValueError("mamba_mimo_bwd_bwd_ptile_crossp_accum requires P % p_tile == 0")
+
+    if reduceO:
+        DOUT_shape = (B, S, H, P)
+    else:
+        DOUT_shape = (B, S, R, H, P)
+
+    @T.prim_func
+    def mamba_mimo_bwd_bwd_ptile_crossp_accum_kernel(
+            DOUT: T.Tensor(DOUT_shape, dtype),  # type: ignore
+            Q: T.Tensor([B, S * R, G, N], dtype),  # type: ignore
+            K: T.Tensor([B, S * R, G, N], dtype),  # type: ignore
+            V: T.Tensor([B, S, H, P], dtype),  # type: ignore
+            Q_BIAS: T.Tensor([H, R, N], T.float32),  # type: ignore
+            K_BIAS: T.Tensor([H, R, N], T.float32),  # type: ignore
+            MIMO_V: T.Tensor([H, R, P], T.float32), # type: ignore
+            MIMO_O: T.Tensor([H, R, P], T.float32), # type: ignore
+            DK: T.Tensor([B, S*R, H, N], dtype),  # type: ignore
+            DV: T.Tensor([B, S, H, P], dtype),  # type: ignore
+            DMIMO_V: T.Tensor([B, H, R, P], T.float32), # type: ignore
+            STATES: T.Tensor([B, H, nchunks, N, P], dtype), # type: ignore
+            DQ: T.Tensor([B, S*R, H, N], dtype),  # type: ignore
+
+            Z: T.Tensor([B, S, H, P], dtype),  # type: ignore
+            MIMO_Z: T.Tensor([H, R, P], T.float32), # type: ignore
+            ANGLES: T.Tensor([B, S, H, N//rotary_dim_divisor], T.float32), # type: ignore
+            DA_CS: T.Tensor([B, H, S], T.float32), # type: ignore
+            DA_CS_REV: T.Tensor([B, H, S], T.float32), # type: ignore
+            DT: T.Tensor([B, H, S], T.float32), # type: ignore
+            TRAP: T.Tensor([B, H, S], dtype), # type: ignore
+            DFACTOR: T.Tensor([B, H, S], T.float32), # type: ignore
+            DGAMMA_DIAG: T.Tensor([B, H, S], T.float32), # type: ignore
+            DANGLES: T.Tensor([B, S, H, N//rotary_dim_divisor], T.float32), # type: ignore
+            D: T.Tensor([H], T.float32), # type: ignore
+            DD: T.Tensor([B, H], T.float32), # type: ignore
+
+            QK_DOT: T.Tensor([B, H, S, R * R], dtype), # type: ignore
+            DDA: T.Tensor([B, H, S], T.float32), # type: ignore
+            DSSDA: T.Tensor([B, H, nchunks, chunk_size, chunk_size], T.float32), # type: ignore
+            DDA_CS_REV: T.Tensor([B, H, S], T.float32), # type: ignore
+            DDA_CS: T.Tensor([B, H, S], T.float32), # type: ignore
+
+            SEGSUM: T.Tensor([B, H, nchunks, chunk_size, chunk_size], T.float32), # type: ignore
+            DSTATES_PTILE: T.Tensor([B, H, n_p_tiles, N, P_TILE], dtype), # type: ignore
+            ):
+        with T.Kernel(H, B, threads=threads) as (i_h, i_b):
+            i_h_qk = i_h // (H // G)
+
+            q_shared = T.alloc_shared([fused_chunk_size, N], dtype)
+            k_shared = T.alloc_shared([fused_chunk_size, N], dtype)
+            q_pre_rot_shared = T.alloc_shared([fused_chunk_size, N], dtype)
+            k_pre_rot_shared = T.alloc_shared([fused_chunk_size, N], dtype)
+            k_pre_trap_shared = T.alloc_shared([fused_chunk_size, N], dtype)
+            lkq_masked__or__dkq_masked_shared = T.alloc_shared([fused_chunk_size, fused_chunk_size], dtype)
+            dqk_from_diag_shared = T.alloc_shared([fused_chunk_size, fused_chunk_size], accum_dtype)
+            dk_shared = T.alloc_shared([fused_chunk_size, N], dtype)
+            dq_shared = T.alloc_shared([fused_chunk_size, N], dtype)
+            qk_dot_shared = T.alloc_shared([chunk_size, R * R], dtype)
+            trap_scale_shared = T.alloc_shared([chunk_size], dtype)
+            dA_cs_shared = T.alloc_shared([chunk_size], T.float32)
+            dangle_dk__or__dq_shared = T.alloc_shared([fused_chunk_size, N//rotary_dim_divisor], T.float32)
+
+            dPhiO_shared_tile = T.alloc_shared([fused_chunk_size, P_TILE], dtype)
+            dPsiV_combined_shared_tile = T.alloc_shared([fused_chunk_size, P_TILE], dtype)
+            PsiV_shared_tile = T.alloc_shared([fused_chunk_size, P_TILE], dtype)
+            dstates_shared_tile = T.alloc_shared([N, P_TILE], dtype)
+            states_shared_tile = T.alloc_shared([N, P_TILE], dtype)
+            v_shared_tile = T.alloc_shared([chunk_size, P_TILE], dtype)
+
+            T.use_swizzle(10, "row")
+            T.no_set_max_nreg()
+
+            q_bias_frag = T.alloc_fragment([R, N], dtype)
+            k_bias_frag = T.alloc_fragment([R, N], dtype)
+            T.copy(Q_BIAS[i_h, :, :], q_bias_frag)
+            T.copy(K_BIAS[i_h, :, :], k_bias_frag)
+
+            for p_block, n, p in T.Parallel(n_p_tiles, N, P_TILE):
+                DSTATES_PTILE[i_b, i_h, p_block, n, p] = 0.0
+            for r, p in T.Parallel(R, P):
+                DMIMO_V[i_b, i_h, r, p] = 0.0
+
+            if hasD:
+                dD_frag = T.alloc_fragment([1], accum_dtype)
+                T.clear(dD_frag)
+
+            for chunk_idx_rev in T.Pipelined(0, nchunks, num_stages=num_stages):
+                chunk_idx = nchunks - 1 - chunk_idx_rev
+                chunk_start = chunk_idx * chunk_size
+                fused_chunk_start = chunk_start * R
+
+                trap_shifted_frag = T.alloc_fragment([chunk_size], T.float32)
+                dt_shifted_frag = T.alloc_fragment([chunk_size], dtype)
+                for cs in T.Parallel(chunk_size):
+                    trap_shifted_frag[cs] = T.if_then_else(
+                        chunk_start + cs + 1 < S,
+                        TRAP[i_b, i_h, chunk_start + cs + 1],
+                        0.0,
+                    )
+                    dt_shifted_frag[cs] = T.if_then_else(
+                        chunk_start + cs + 1 < S,
+                        DT[i_b, i_h, chunk_start + cs + 1],
+                        0.0,
+                    )
+                shifted_gamma_frag = T.alloc_fragment([chunk_size], dtype)
+                for cs in T.Parallel(chunk_size):
+                    shifted_gamma_frag[cs] = T.if_then_else(
+                        chunk_start + cs < (S - 1),
+                        dt_shifted_frag[cs] * T.sigmoid(-trap_shifted_frag[cs]),
+                        0.0,
+                    )
+
+                trap_frag = T.alloc_fragment([chunk_size], T.float32)
+                T.copy(TRAP[i_b, i_h, chunk_start: chunk_start+chunk_size], trap_frag, disable_tma=True)
+                dt_frag = T.alloc_fragment([chunk_size], dtype)
+                T.copy(DT[i_b, i_h, chunk_start: chunk_start+chunk_size], dt_frag, disable_tma=True)
+                gamma_frag = T.alloc_fragment([chunk_size], T.float32)
+                for cs in T.Parallel(chunk_size):
+                    gamma_frag[cs] = dt_frag[cs] * T.sigmoid(trap_frag[cs])
+                gamma_cached_frag = T.alloc_fragment([chunk_size], T.float32)
+                T.copy(gamma_frag, gamma_cached_frag)
+                trap_scale_frag = T.alloc_fragment([chunk_size], dtype)
+                for cs in T.Parallel(chunk_size):
+                    trap_scale_frag[cs] = gamma_frag[cs] + shifted_gamma_frag[cs]
+                T.copy(trap_scale_frag, trap_scale_shared)
+
+                T.copy(Q[i_b, fused_chunk_start:fused_chunk_start+fused_chunk_size, i_h_qk, :], q_shared)
+                q_frag = T.alloc_fragment([fused_chunk_size, N], dtype)
+                T.copy(q_shared, q_frag)
+                for cs, r, n in T.Parallel(chunk_size, R, N):
+                    q_frag[cs * R + r, n] += q_bias_frag[r, n]
+                T.copy(q_frag, q_shared)
+                T.copy(q_shared, q_pre_rot_shared)
+
+                angles_frag = T.alloc_fragment([chunk_size, N//rotary_dim_divisor], T.float32)
+                T.copy(ANGLES[i_b, chunk_start:chunk_start+chunk_size, i_h, :], angles_frag)
+                q_first_half_frag = T.alloc_fragment([chunk_size, R, N//rotary_dim_divisor], dtype)
+                q_second_half_frag = T.alloc_fragment([chunk_size, R, N//rotary_dim_divisor], dtype)
+                for cs, r, n in T.Parallel(chunk_size, R, N//rotary_dim_divisor):
+                    q_first_half_frag[cs, r, n] = q_shared[cs*R + r, n]
+                    q_second_half_frag[cs, r, n] = q_shared[cs*R + r, N//2 + n]
+                for cs, r, n in T.Parallel(chunk_size, R, N//rotary_dim_divisor):
+                    q_shared[cs*R + r, n] = T.cos(angles_frag[cs, n]) * q_first_half_frag[cs, r, n] - T.sin(angles_frag[cs, n]) * q_second_half_frag[cs, r, n]
+                    q_shared[cs*R + r, N//2 + n] = T.sin(angles_frag[cs, n]) * q_first_half_frag[cs, r, n] + T.cos(angles_frag[cs, n]) * q_second_half_frag[cs, r, n]
+
+                T.copy(K[i_b, fused_chunk_start:fused_chunk_start+fused_chunk_size, i_h_qk, :], k_pre_trap_shared)
+                k_frag = T.alloc_fragment([fused_chunk_size, N], dtype)
+                T.copy(k_pre_trap_shared, k_frag)
+                for cs, r, n in T.Parallel(chunk_size, R, N):
+                    k_frag[cs * R + r, n] += k_bias_frag[r, n]
+                T.copy(k_frag, k_pre_trap_shared)
+                T.copy(k_pre_trap_shared, k_pre_rot_shared)
+
+                k_first_half_frag = T.alloc_fragment([chunk_size, R, N//rotary_dim_divisor], dtype)
+                k_second_half_frag = T.alloc_fragment([chunk_size, R, N//rotary_dim_divisor], dtype)
+                for cs, r, n in T.Parallel(chunk_size, R, N//rotary_dim_divisor):
+                    k_first_half_frag[cs, r, n] = k_pre_trap_shared[cs*R + r, n]
+                    k_second_half_frag[cs, r, n] = k_pre_trap_shared[cs*R + r, N//2 + n]
+                for cs, r, n in T.Parallel(chunk_size, R, N//rotary_dim_divisor):
+                    k_pre_trap_shared[cs*R + r, n] = T.cos(angles_frag[cs, n]) * k_first_half_frag[cs, r, n] - T.sin(angles_frag[cs, n]) * k_second_half_frag[cs, r, n]
+                    k_pre_trap_shared[cs*R + r, N//2 + n] = T.sin(angles_frag[cs, n]) * k_first_half_frag[cs, r, n] + T.cos(angles_frag[cs, n]) * k_second_half_frag[cs, r, n]
+
+                k_trap_scaled_frag = T.alloc_fragment([fused_chunk_size, N], dtype)
+                T.copy(k_pre_trap_shared, k_trap_scaled_frag)
+                for csr, n in T.Parallel(fused_chunk_size, N):
+                    k_trap_scaled_frag[csr, n] *= trap_scale_shared[csr//R]
+                T.copy(k_trap_scaled_frag, k_shared)
+
+                lkq_frag = T.alloc_fragment([fused_chunk_size, fused_chunk_size], accum_dtype)
+                T.gemm(k_shared, q_shared, lkq_frag, transpose_B=True, clear_accum=True)
+                for csr_i, csr_j in T.Parallel(fused_chunk_size, fused_chunk_size):
+                    lkq_frag[csr_i, csr_j] = T.if_then_else(
+                        csr_i//R < csr_j//R,
+                        lkq_frag[csr_i, csr_j] * T.exp(SEGSUM[i_b, i_h, chunk_idx, csr_j//R, csr_i//R]),
+                        0.0,
+                    )
+                T.copy(lkq_frag, lkq_masked__or__dkq_masked_shared)
+
+                T.copy(QK_DOT[i_b, i_h, chunk_start:chunk_start+chunk_size, :], qk_dot_shared)
+
+                dqk_from_diag_acc = T.alloc_fragment([fused_chunk_size, fused_chunk_size], accum_dtype)
+                dk_acc = T.alloc_fragment([fused_chunk_size, N], accum_dtype)
+                dk_intrachunk_acc = T.alloc_fragment([fused_chunk_size, fused_chunk_size], accum_dtype)
+                dq_acc = T.alloc_fragment([fused_chunk_size, N], accum_dtype)
+                ddA_state_passing = T.alloc_fragment([1], T.float32)
+                T.clear(dqk_from_diag_acc)
+                T.clear(dk_acc)
+                T.clear(dk_intrachunk_acc)
+                T.clear(dq_acc)
+                T.clear(ddA_state_passing)
+
+                for p_block in T.serial(n_p_tiles):
+                    p_start = p_block * P_TILE
+
+                    T.copy(DSTATES_PTILE[i_b, i_h, p_block, :, :], dstates_shared_tile)
+                    dstates_frag_tile = T.alloc_fragment([N, P_TILE], accum_dtype)
+                    T.copy(dstates_shared_tile, dstates_frag_tile)
+
+                    Psi_frag_tile = T.alloc_fragment([R, P_TILE], dtype)
+                    Phi_frag_tile = T.alloc_fragment([R, P_TILE], dtype)
+                    for r, p in T.Parallel(R, P_TILE):
+                        Psi_frag_tile[r, p] = MIMO_V[i_h, r, p_start + p]
+                        if reduceO:
+                            Phi_frag_tile[r, p] = MIMO_O[i_h, r, p_start + p]
+
+                    for cs, p in T.Parallel(chunk_size, P_TILE):
+                        v_shared_tile[cs, p] = V[i_b, chunk_start + cs, i_h, p_start + p]
+
+                    dPhiO_frag_tile = T.alloc_fragment([chunk_size, R, P_TILE], dtype)
+                    if reduceO:
+                        dout_frag_tile = T.alloc_fragment([chunk_size, P_TILE], dtype)
+                        for cs, p in T.Parallel(chunk_size, P_TILE):
+                            dout_frag_tile[cs, p] = DOUT[i_b, chunk_start + cs, i_h, p_start + p]
+                        for cs, r, p in T.Parallel(chunk_size, R, P_TILE):
+                            dPhiO_frag_tile[cs, r, p] = dout_frag_tile[cs, p] * Phi_frag_tile[r, p]
+                    else:
+                        for cs, r, p in T.Parallel(chunk_size, R, P_TILE):
+                            dPhiO_frag_tile[cs, r, p] = DOUT[i_b, chunk_start + cs, r, i_h, p_start + p]
+
+                    if hasZ:
+                        Zeta_frag_tile = T.alloc_fragment([R, P_TILE], dtype)
+                        z_frag_tile = T.alloc_fragment([chunk_size, P_TILE], dtype)
+                        for r, p in T.Parallel(R, P_TILE):
+                            Zeta_frag_tile[r, p] = MIMO_Z[i_h, r, p_start + p]
+                        for cs, p in T.Parallel(chunk_size, P_TILE):
+                            z_frag_tile[cs, p] = Z[i_b, chunk_start + cs, i_h, p_start + p]
+                        for cs, r, p in T.Parallel(chunk_size, R, P_TILE):
+                            tmp = z_frag_tile[cs, p] * Zeta_frag_tile[r, p] * 0.5
+                            dPhiO_frag_tile[cs, r, p] *= tmp * T.tanh(tmp) + tmp
+
+                    T.copy(T.view(dPhiO_frag_tile, shape=[fused_chunk_size, P_TILE]), dPhiO_shared_tile)
+
+                    if hasD:
+                        v_dD_frag_tile = T.alloc_fragment([chunk_size, P_TILE], accum_dtype)
+                        Psi_dD_frag_tile = T.alloc_fragment([R, P_TILE], accum_dtype)
+                        T.copy(v_shared_tile, v_dD_frag_tile)
+                        T.copy(Psi_frag_tile, Psi_dD_frag_tile)
+                        for cs, r, p in T.Parallel(chunk_size, R, P_TILE):
+                            dPhiO_frag_tile[cs, r, p] *= v_dD_frag_tile[cs, p] * Psi_dD_frag_tile[r, p]
+                        T.reduce_sum(T.view(dPhiO_frag_tile, shape=[fused_chunk_size * P_TILE]), dD_frag, clear=False)
+
+                    dPsiV_frag_tile = T.alloc_fragment([fused_chunk_size, P_TILE], accum_dtype)
+                    T.gemm(k_shared, dstates_shared_tile, dPsiV_frag_tile, clear_accum=True)
+                    dA_cs_rev_frag = T.alloc_fragment([chunk_size], T.float32)
+                    T.copy(DA_CS_REV[i_b, i_h, chunk_start:chunk_start+chunk_size], dA_cs_rev_frag, disable_tma=True)
+                    for csr, p in T.Parallel(fused_chunk_size, P_TILE):
+                        dPsiV_frag_tile[csr, p] *= T.exp(dA_cs_rev_frag[csr//R])
+
+                    T.gemm(lkq_masked__or__dkq_masked_shared, dPhiO_shared_tile, dPsiV_frag_tile, clear_accum=False)
+
+                    dPsiV_D_fused_frag_tile = T.alloc_fragment([fused_chunk_size, P_TILE], accum_dtype)
+                    if hasD:
+                        D_frag = T.alloc_var(T.float32)
+                        T.copy(D[i_h], D_frag)
+                        for csr, p in T.Parallel(fused_chunk_size, P_TILE):
+                            dPsiV_D_fused_frag_tile[csr, p] = dPsiV_frag_tile[csr, p] + dPhiO_shared_tile[csr, p] * D_frag
+                    else:
+                        T.copy(dPsiV_frag_tile, dPsiV_D_fused_frag_tile)
+                    gamma_dPsiV_frag = T.alloc_fragment([chunk_size], dtype)
+                    T.copy(gamma_frag, gamma_dPsiV_frag)
+                    for cs, r_in, p in T.Parallel(chunk_size, R, P_TILE):
+                        csr = cs * R + r_in
+                        for r_out in T.serial(R):
+                            csr_out = cs * R + r_out
+                            dPsiV_D_fused_frag_tile[csr, p] += dPhiO_shared_tile[csr_out, p] * qk_dot_shared[cs, r_out * R + r_in] * gamma_dPsiV_frag[cs]
+                    T.copy(dPsiV_D_fused_frag_tile, dPsiV_combined_shared_tile)
+
+                    dv_frag_tile = T.alloc_fragment([chunk_size, P_TILE], dtype)
+                    T.clear(dv_frag_tile)
+                    for cs, p in T.Parallel(chunk_size, P_TILE):
+                        for r in T.serial(R):
+                            dv_frag_tile[cs, p] += dPsiV_combined_shared_tile[cs*R + r, p] * Psi_frag_tile[r, p]
+                    for cs, p in T.Parallel(chunk_size, P_TILE):
+                        DV[i_b, chunk_start + cs, i_h, p_start + p] = dv_frag_tile[cs, p]
+
+                    dPsi_frag_tile = T.alloc_fragment([R, P_TILE], accum_dtype)
+                    for r, p in T.Parallel(R, P_TILE):
+                        dPsi_frag_tile[r, p] = DMIMO_V[i_b, i_h, r, p_start + p]
+                    v_frag_tile = T.alloc_fragment([chunk_size, P_TILE], accum_dtype)
+                    T.copy(v_shared_tile, v_frag_tile)
+                    for r, p in T.Parallel(R, P_TILE):
+                        for cs in T.serial(chunk_size):
+                            dPsi_frag_tile[r, p] += dPsiV_combined_shared_tile[cs*R + r, p] * v_frag_tile[cs, p]
+                    for r, p in T.Parallel(R, P_TILE):
+                        DMIMO_V[i_b, i_h, r, p_start + p] = dPsi_frag_tile[r, p]
+
+                    PsiV_frag_tile = T.alloc_fragment([chunk_size, R, P_TILE], dtype)
+                    T.clear(PsiV_frag_tile)
+                    for cs, p in T.Parallel(chunk_size, P_TILE):
+                        for r in T.serial(R):
+                            PsiV_frag_tile[cs, r, p] += v_frag_tile[cs, p] * Psi_frag_tile[r, p]
+                    for cs, r, p in T.Parallel(chunk_size, R, P_TILE):
+                        PsiV_shared_tile[cs*R + r, p] = PsiV_frag_tile[cs, r, p]
+
+                    T.gemm(dPhiO_shared_tile, PsiV_shared_tile, dqk_from_diag_acc, transpose_B=True, clear_accum=False)
+                    T.gemm(PsiV_shared_tile, dstates_shared_tile, dk_acc, transpose_B=True, clear_accum=False)
+                    T.gemm(PsiV_shared_tile, dPhiO_shared_tile, dk_intrachunk_acc, transpose_B=True, clear_accum=False)
+
+                    for n, p in T.Parallel(N, P_TILE):
+                        states_shared_tile[n, p] = STATES[i_b, i_h, chunk_idx, n, p_start + p]
+                    T.gemm(dPhiO_shared_tile, states_shared_tile, dq_acc, transpose_B=True, clear_accum=False)
+
+                    states_frag_tile = T.alloc_fragment([N, P_TILE], T.float32)
+                    T.copy(states_shared_tile, states_frag_tile)
+                    ddA_state_passing_prereduce_frag_tile = T.alloc_fragment([N, P_TILE], T.float32)
+                    da_cs_sum = T.alloc_var(T.float32)
+                    if tail_len > 0 and chunk_idx == nchunks - 1:
+                        T.copy(DA_CS[i_b, i_h, S - 1], da_cs_sum)
+                    else:
